# auto：配置 AMAP_MCP_URL 时接入真实高德 MCP，否则使用本地演示坐标。
# amap：强制使用真实 MCP；demo：强制使用本地演示坐标。
MAPS_PROVIDER=auto
AMAP_MCP_URL=
# LangChain MCP Adapter transport: http (Streamable HTTP) or sse.
AMAP_MCP_TRANSPORT=http
# 官方 Streamable HTTP 地址格式：
# AMAP_MCP_URL=https://mcp.amap.com/mcp?key=你的高德Web服务Key

DELIVERY_RADIUS_KM=5
RESTAURANT_LONGITUDE=121.4737
RESTAURANT_LATITUDE=31.2304
LOG_LEVEL=INFO

# MySQL 8 / InnoDB, used by SQLAlchemy for menu, reservations and agent state.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=menu
MYSQL_CHARSET=utf8mb4
# Optional: MYSQL_URL=mysql+pymysql://user:password@host:3306/menu?charset=utf8mb4

# Redis stores FAQ question/answer hashes. No in-memory fallback is used.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_FAQ_PREFIX=restaurant:faq:

# The default LangChain model is deterministic and local. Set provider=openai
# only when an OpenAI model is configured for real inference.
AGENT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30

# 填写老师提供的远端 Milvus/Zilliz 服务地址；项目不会在本机启动 Milvus。
MILVUS_URI=
MILVUS_COLLECTION=restaurant_menu
# 远端集群需要鉴权时填写；不要将真实 token 提交到仓库。
MILVUS_TOKEN=

# BGE model must already exist at this local path; app startup never downloads it.
EMBEDDING_MODEL_PATH=models/bge-base-zh
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
